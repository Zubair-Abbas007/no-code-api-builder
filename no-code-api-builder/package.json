{
  "name": "no-code-api-builder",
  "version": "1.0.0",
  "description": "A no-code API builder that lets users create, manage, and test REST API endpoints visually",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "jest --no-coverage",
    "lint": "eslint server/ --ext .js",
    "build": "echo 'No build step required for Node.js backend'"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.18.2",
    "uuid": "9.0.0"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "nodemon": "3.0.2",
    "supertest": "6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/index.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
